---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import LeadForm from '../components/LeadForm.astro';
import Coaches from '../components/Coaches.astro';
import Testimonials from '../components/Testimonials.astro';
import Footer from '../components/Footer.astro';
import BookingModal from '../components/BookingModal.astro';
---

<Layout 
  title="Kids Martial Arts & BJJ Classes Bloomfield Township | Assembly Jiu Jitsu"
  description="Empower your child with confidence, focus, discipline and bully-proof self-defense at Assembly Jiu Jitsu in Bloomfield Township, MI. Free trial class pass for ages 5-13."
>
  <Header />

  <!-- Kids Hero Section -->
  <section id="kids-hero" class="relative w-full overflow-hidden bg-black text-white py-12 md:py-20 lg:py-28">
    <!-- Video & Gradient Overlay -->
    <div class="absolute inset-0 z-0 overflow-hidden">
      <video 
        autoplay 
        loop 
        muted 
        playsinline 
        class="h-full w-full object-cover opacity-45 filter brightness-90"
        poster="/kids-1.jpg"
      >
        <source src="/hero-video.mov" type="video/mp4" />
      </video>
      <div class="absolute inset-0 bg-gradient-to-r from-black via-black/45 to-black/30"></div>
    </div>

    <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Left Content -->
        <div class="lg:col-span-6 max-w-2xl">
          
          <!-- Social Proof Rating Badge -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs sm:text-sm font-bold uppercase tracking-wider mb-4">
            <div class="flex gap-0.5 text-amber-400">
              {Array.from({ length: 5 }).map(() => (
                <svg class="w-4 h-4 fill-amber-400" viewBox="0 0 24 24">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                </svg>
              ))}
            </div>
            <span>5.0 Rating • 120+ Google Reviews</span>
          </div>
          
          <h1 class="mb-6 text-3xl sm:text-5xl lg:text-6xl font-heading font-extrabold tracking-tight uppercase leading-[1.1] text-white drop-shadow-md">
            BUILD CONFIDENCE &amp; DISCIPLINE WITH KIDS JIU-JITSU
          </h1>

          <p class="text-base sm:text-xl text-gray-200 font-normal leading-relaxed mb-8">
            Bloomfield Township’s premier youth martial arts program (Ages 5–13). A fun, encouraging environment where children build real self-defense, focus, and lifelong confidence.
          </p>

          <!-- Highlights -->
          <div class="grid grid-cols-2 gap-4 text-xs sm:text-sm font-semibold text-gray-300 border-t border-white/15 pt-6">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-rose-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>100% Beginner Friendly</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-rose-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Bully-Proof Self-Defense</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-rose-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Focus &amp; Discipline</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-rose-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Youth Programs (Ages 5–13)</span>
            </div>
          </div>
        </div>

        <!-- Right Lead Form -->
        <div class="lg:col-span-6 w-full">
          <LeadForm defaultAudience="child" formName="Kids Form" />
        </div>

      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <Testimonials />

  <!-- Why Parents Choose Assembly Kids Section -->
  <section class="py-20 bg-slate-50 text-slate-900">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold uppercase tracking-tight text-slate-900 mb-4">
          Why Parents Choose Assembly Jiu Jitsu
        </h2>
        <p class="text-lg text-slate-600">
          Our Kids BJJ curriculum focuses on character development, physical agility, and non-violent conflict resolution.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        
        <!-- Card 1: Minimal Flat Shield Icon -->
        <div class="bg-white p-8 rounded-2xl border border-slate-200/80 shadow-md hover:shadow-xl transition-all">
          <div class="w-14 h-14 rounded-2xl bg-rose-50 border border-rose-100 text-rose-600 flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-heading font-bold uppercase mb-3 text-slate-900">
            Bully-Proof Self-Defense
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Unlike martial arts that rely on punching or kicking, Brazilian Jiu-Jitsu teaches children leverage and control to neutralize bigger bullies safely without causing injury.
          </p>
        </div>

        <!-- Card 2: Minimal Flat Target Icon -->
        <div class="bg-white p-8 rounded-2xl border border-slate-200/80 shadow-md hover:shadow-xl transition-all">
          <div class="w-14 h-14 rounded-2xl bg-rose-50 border border-rose-100 text-rose-600 flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <circle cx="12" cy="12" r="6"></circle>
              <circle cx="12" cy="12" r="2"></circle>
            </svg>
          </div>
          <h3 class="text-xl font-heading font-bold uppercase mb-3 text-slate-900">
            Focus &amp; Discipline
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Our structured classes instill respect, active listening, and self-control. Parents notice immediate improvements in attention span both at school and at home.
          </p>
        </div>

        <!-- Card 3: Minimal Flat Users Icon -->
        <div class="bg-white p-8 rounded-2xl border border-slate-200/80 shadow-md hover:shadow-xl transition-all">
          <div class="w-14 h-14 rounded-2xl bg-rose-50 border border-rose-100 text-rose-600 flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <h3 class="text-xl font-heading font-bold uppercase mb-3 text-slate-900">
            Positive Social Environment
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Kids train in a warm, welcoming team environment where every student supports each other. It’s the perfect place to build lifelong friendships and social confidence.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- Real Kids Action Showcase Gallery Section -->
  <section class="py-20 bg-slate-900 text-white border-t border-slate-800">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-rose-500 font-bold uppercase tracking-wider text-xs sm:text-sm block mb-2">
          Real Students • Real Progress
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold uppercase tracking-tight text-white mb-4">
          Inside Our Kids BJJ Classes
        </h2>
        <p class="text-gray-300 text-base sm:text-lg">
          See our young martial artists building confidence, technique, and strong friendships on the mat at Assembly Jiu Jitsu Bloomfield.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Photo 1 -->
        <div class="group relative rounded-2xl overflow-hidden bg-slate-800 border border-slate-700 shadow-2xl aspect-[3/5]">
          <img 
            src="/kids-1.jpg" 
            alt="Assembly Kids Jiu Jitsu Student Standing Tall in Gi" 
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent flex flex-col justify-end p-5">
            <span class="text-rose-400 text-xs font-extrabold uppercase tracking-wider mb-1">Fundamentals &amp; Gi Training</span>
            <h3 class="text-white font-bold text-base">Confidence &amp; Control</h3>
          </div>
        </div>

        <!-- Photo 2 -->
        <div class="group relative rounded-2xl overflow-hidden bg-slate-800 border border-slate-700 shadow-2xl aspect-[3/5]">
          <img 
            src="/kids-2.jpg" 
            alt="Kids BJJ Ground Control Drill" 
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent flex flex-col justify-end p-5">
            <span class="text-rose-400 text-xs font-extrabold uppercase tracking-wider mb-1">Technique &amp; Control</span>
            <h3 class="text-white font-bold text-base">Safe Mat Sparring</h3>
          </div>
        </div>

        <!-- Photo 3 -->
        <div class="group relative rounded-2xl overflow-hidden bg-slate-800 border border-slate-700 shadow-2xl aspect-[3/5]">
          <img 
            src="/kids-3.jpg" 
            alt="Kids Jiu Jitsu Teammates Partner Drill" 
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent flex flex-col justify-end p-5">
            <span class="text-rose-400 text-xs font-extrabold uppercase tracking-wider mb-1">Supportive Team</span>
            <h3 class="text-white font-bold text-base">Teamwork &amp; Friendship</h3>
          </div>
        </div>

        <!-- Photo 4 -->
        <div class="group relative rounded-2xl overflow-hidden bg-slate-800 border border-slate-700 shadow-2xl aspect-[3/5]">
          <img 
            src="/kids-4.jpg" 
            alt="Kids Guard Pass Practice" 
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent flex flex-col justify-end p-5">
            <span class="text-rose-400 text-xs font-extrabold uppercase tracking-wider mb-1">Supervised Coaching</span>
            <h3 class="text-white font-bold text-base">Leverage over Force</h3>
          </div>
        </div>

      </div>

      <div class="mt-12 text-center">
        <button type="button" class="open-modal-btn btn-primary h-14 px-10 text-lg font-extrabold uppercase tracking-wider cursor-pointer">
          Claim Your Child's Free Trial Pass
        </button>
      </div>

    </div>
  </section>

  <!-- Coaches Section -->
  <Coaches />

  <!-- Kids FAQ Section -->
  <section class="py-20 bg-slate-900 text-white border-t border-slate-800">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-heading font-extrabold uppercase tracking-tight text-white mb-4">
          Frequently Asked Questions (Parents)
        </h2>
        <p class="text-gray-400 text-base sm:text-lg">
          Everything you need to know about your child's first class at Assembly.
        </p>
      </div>

      <div class="space-y-4">
        <!-- Q1 -->
        <div class="bg-slate-800/80 rounded-xl p-6 border border-slate-700">
          <h3 class="font-bold text-lg text-white mb-2">
            What age can my child start Jiu-Jitsu?
          </h3>
          <p class="text-gray-300 text-sm leading-relaxed">
            Our youth program starts at age 5! We separate classes by age and skill group (Little Champions 5-7 and Youth 8-13) to ensure age-appropriate coaching and maximum safety.
          </p>
        </div>

        <!-- Q2 -->
        <div class="bg-slate-800/80 rounded-xl p-6 border border-slate-700">
          <h3 class="font-bold text-lg text-white mb-2">
            Will my child get hurt?
          </h3>
          <p class="text-gray-300 text-sm leading-relaxed">
            Safety is our #1 priority. Our world-class black belt instructors closely supervise every drill and sparring session in a controlled, non-violent environment.
          </p>
        </div>

        <!-- Q3 -->
        <div class="bg-slate-800/80 rounded-xl p-6 border border-slate-700">
          <h3 class="font-bold text-lg text-white mb-2">
            What should my child wear to their first class?
          </h3>
          <p class="text-gray-300 text-sm leading-relaxed">
            Comfortable athletic clothes like t-shirt and shorts/sweatpants (no zippers or metal buttons). We provide loaner gear for your free trial pass!
          </p>
        </div>

        <!-- Q4 -->
        <div class="bg-slate-800/80 rounded-xl p-6 border border-slate-700">
          <h3 class="font-bold text-lg text-white mb-2">
            What if my child has zero prior martial arts experience?
          </h3>
          <p class="text-gray-300 text-sm leading-relaxed">
            No experience is required! 90%+ of our new kids start as complete beginners. Our coaches guide them step-by-step at their own pace.
          </p>
        </div>
      </div>

      <div class="mt-12 text-center">
        <button type="button" class="open-modal-btn btn-primary h-14 px-10 text-lg font-extrabold uppercase tracking-wider cursor-pointer">
          Claim Free Trial Pass Now
        </button>
      </div>
    </div>
  </section>

  <Footer />
  <BookingModal />
</Layout>
