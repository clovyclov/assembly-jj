---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Thank You | Assembly Jiu Jitsu Bloomfield"
  description="Thank you for booking your trial class at Assembly Jiu Jitsu in Bloomfield Township, MI."
>
  <Header />

  <!-- Clean Structured Thank You Section -->
  <section class="py-16 md:py-24 bg-slate-50 text-slate-900 min-h-[80vh] flex flex-col justify-center">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
      
      <!-- Confirmation Header -->
      <div class="text-center mb-12">
        <div class="w-16 h-16 rounded-full bg-emerald-100 border border-emerald-200 text-emerald-600 flex items-center justify-center mx-auto mb-4 font-bold text-2xl shadow-sm">
          ✓
        </div>
        <span class="text-rose-600 font-bold uppercase tracking-wider text-xs sm:text-sm block mb-1">
          Reservation Received
        </span>
        <h1 class="text-3xl sm:text-5xl font-heading font-extrabold uppercase text-slate-900 tracking-tight mb-3">
          YOU'RE ALL SET!
        </h1>
        <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto font-normal leading-relaxed">
          Your free class pass and session reservation have been received. We look forward to seeing you on the mats!
        </p>
      </div>

      <!-- Structured 3-Card "What To Expect Next" Grid -->
      <div class="bg-white rounded-2xl p-6 sm:p-10 border border-slate-200 shadow-lg mb-10">
        <h2 class="text-xl sm:text-2xl font-heading font-bold uppercase text-slate-900 mb-8 text-center tracking-wide">
          What To Expect Next
        </h2>

        <div class="grid sm:grid-cols-3 gap-8">
          
          <!-- Step 1 -->
          <div class="flex flex-col items-center text-center p-4 rounded-xl bg-slate-50 border border-slate-100">
            <div class="w-10 h-10 rounded-lg bg-rose-600 text-white font-extrabold text-lg flex items-center justify-center mb-4 shadow-sm">
              1
            </div>
            <h3 class="font-bold text-base text-slate-900 mb-2">Check Your Inbox</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
              We sent your pass details and booking confirmation via email and SMS text.
            </p>
          </div>

          <!-- Step 2 -->
          <div class="flex flex-col items-center text-center p-4 rounded-xl bg-slate-50 border border-slate-100">
            <div class="w-10 h-10 rounded-lg bg-rose-600 text-white font-extrabold text-lg flex items-center justify-center mb-4 shadow-sm">
              2
            </div>
            <h3 class="font-bold text-base text-slate-900 mb-2">What To Wear</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
              Wear comfortable athletic clothing (t-shirt and shorts/sweatpants). We provide loaner gear!
            </p>
          </div>

          <!-- Step 3 -->
          <div class="flex flex-col items-center text-center p-4 rounded-xl bg-slate-50 border border-slate-100">
            <div class="w-10 h-10 rounded-lg bg-rose-600 text-white font-extrabold text-lg flex items-center justify-center mb-4 shadow-sm">
              3
            </div>
            <h3 class="font-bold text-base text-slate-900 mb-2">Arrive 10 Mins Early</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
              Arrive a few minutes early so our black belt instructors can give you a tour of the academy.
            </p>
          </div>

        </div>
      </div>

      <!-- Location & Action Contact Bar -->
      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-md flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="text-center md:text-left">
          <h4 class="font-bold text-slate-900 text-base mb-1">Assembly Jiu Jitsu Bloomfield</h4>
          <p class="text-slate-600 text-xs sm:text-sm">
            281 Enterprise Ct Suite 400, Bloomfield Township, MI 48302
          </p>
        </div>

        <div class="flex flex-wrap justify-center gap-3">
          <a 
            href="tel:2484138386" 
            class="btn-primary h-12 px-6 text-sm font-extrabold uppercase tracking-wider flex items-center justify-center gap-2"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            (248) 413-8386
          </a>

          <a 
            href="/" 
            class="btn-secondary-bold h-12 px-6 text-sm font-extrabold uppercase tracking-wider flex items-center justify-center"
          >
            Back To Home
          </a>
        </div>
      </div>

    </div>
  </section>

  <Footer />
</Layout>
