---
---
<section id="video-feature" class="py-20 bg-white text-slate-900">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      
      <!-- Text & Bullet Points -->
      <div class="order-2 lg:order-1">
        <span class="text-rose-600 font-bold uppercase tracking-wider text-sm mb-2 block">
          Experience Assembly Jiu Jitsu
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold tracking-tight uppercase mb-6 text-slate-900">
          See Us In Action
        </h2>
        <p class="text-lg text-slate-600 mb-8 leading-relaxed">
          Get a glimpse of the energy, technique, and community at Assembly Jiu Jitsu. Whether you're aiming to compete or just looking for a great workout, our mats are open to everyone. Watch our team in action and see what makes our academy special.
        </p>

        <ul class="space-y-4 mb-10">
          <li class="flex items-start">
            <div class="h-7 w-7 rounded-full bg-rose-100 flex items-center justify-center mr-4 flex-shrink-0 mt-0.5 border border-rose-200">
              <div class="h-2.5 w-2.5 rounded-full bg-rose-600"></div>
            </div>
            <span class="text-lg font-medium text-slate-800">
              High-energy, structured classes for all skill levels.
            </span>
          </li>
          <li class="flex items-start">
            <div class="h-7 w-7 rounded-full bg-rose-100 flex items-center justify-center mr-4 flex-shrink-0 mt-0.5 border border-rose-200">
              <div class="h-2.5 w-2.5 rounded-full bg-rose-600"></div>
            </div>
            <span class="text-lg font-medium text-slate-800">
              Supportive environment focused on technical growth.
            </span>
          </li>
        </ul>

        <button 
          type="button" 
          class="open-modal-btn btn-primary h-14 px-8 font-extrabold text-lg uppercase tracking-wider rounded-none shadow-xl cursor-pointer"
        >
          Book Your Free Class
        </button>
      </div>

      <!-- Video Player Embed Card -->
      <div class="order-1 lg:order-2">
        <div class="rounded-2xl overflow-hidden shadow-2xl border border-slate-800 bg-black relative group">
          <div class="aspect-video w-full relative">
            <iframe 
              src="https://player.mediadelivery.net/embed/194365/1c26f4b0-215e-4d22-a6fb-8007385a2431?autoplay=false&loop=false&muted=false&preload=true&responsive=true" 
              loading="lazy" 
              allow="accelerometer;gyroscope;autoplay;encrypted-media;picture-in-picture;" 
              allowfullscreen 
              class="w-full h-full border-0 absolute inset-0"
              title="Assembly Jiu Jitsu Action Video"
            ></iframe>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
