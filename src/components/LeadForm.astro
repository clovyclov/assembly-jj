---
interface Props {
  defaultAudience?: 'myself' | 'child';
  formName?: string;
}
const { 
  defaultAudience = 'myself', 
  formName = defaultAudience === 'child' ? 'Kids Form' : 'Adult Form' 
} = Astro.props;
---
<div class="w-full bg-white rounded-2xl p-6 sm:p-8 shadow-2xl border border-slate-100 text-slate-900">
  
  <!-- Header -->
  <div class="text-center mb-6">
    <h2 class="text-2xl sm:text-3xl font-heading font-bold text-slate-900 tracking-tight mb-2">
      Claim Your Free Class Now
    </h2>
    <p class="text-xs sm:text-sm text-slate-600 font-normal leading-relaxed max-w-md mx-auto">
      Fill out the form and we'll send your pass over.
    </p>
  </div>

  <!-- Form -->
  <form 
    id="lead-capture-form" 
    class="space-y-5" 
    action="/api/claim-pass" 
    method="POST"
    onsubmit="event.preventDefault(); handleFormSubmit(this);"
  >
    <!-- Hidden Form Identifier Fields -->
    <input type="hidden" name="formName" value={formName} />
    <input type="hidden" name="formType" value={formName} />

    <!-- Full Name -->
    <div>
      <label for="full-name" class="block text-xs font-bold text-slate-800 mb-1.5">
        Full Name
      </label>
      <input 
        type="text" 
        id="full-name" 
        name="fullName" 
        required 
        placeholder="Enter your full name" 
        class="w-full bg-[#eaeff2] border border-[#d8e0e5] rounded-lg px-4 py-3.5 text-sm text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 focus:outline-none transition-all"
      />
    </div>

    <!-- Email -->
    <div>
      <label for="email" class="block text-xs font-bold text-slate-800 mb-1.5">
        Email *
      </label>
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <input 
          type="email" 
          id="email" 
          name="email" 
          required 
          placeholder="Email" 
          class="w-full bg-[#eaeff2] border border-[#d8e0e5] rounded-lg pl-10 pr-4 py-3.5 text-sm text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 focus:outline-none transition-all"
        />
      </div>
    </div>

    <!-- Phone -->
    <div>
      <label for="phone" class="block text-xs font-bold text-slate-800 mb-1.5">
        Phone *
      </label>
      <input 
        type="tel" 
        id="phone" 
        name="phone" 
        required 
        placeholder="Phone" 
        class="w-full bg-[#eaeff2] border border-[#d8e0e5] rounded-lg px-4 py-3.5 text-sm text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 focus:outline-none transition-all"
      />
    </div>

    <!-- Age -->
    <div>
      <label for="age" class="block text-xs font-bold text-slate-800 mb-1.5">
        Age *
      </label>
      <input 
        type="number" 
        id="age" 
        name="age" 
        required 
        placeholder="Age" 
        min="1" 
        max="100" 
        class="w-full bg-[#eaeff2] border border-[#d8e0e5] rounded-lg px-4 py-3.5 text-sm text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 focus:outline-none transition-all"
      />
    </div>

    <!-- Who is the class for? (Custom Button Selection) -->
    <div>
      <label class="block text-xs font-bold text-slate-800 mb-2">
        Who is the class for?
      </label>
      <input type="hidden" name="targetAudience" id="targetAudienceInput" value={defaultAudience} />
      
      <div class="grid grid-cols-2 gap-3">
        <button 
          type="button" 
          data-audience="myself" 
          class={`audience-btn py-3 px-4 rounded-lg text-sm font-bold border-2 border-black text-center transition-all cursor-pointer ${
            defaultAudience === 'myself' 
              ? 'bg-black text-white' 
              : 'bg-white text-black hover:bg-slate-100'
          }`}
        >
          Myself
        </button>

        <button 
          type="button" 
          data-audience="child" 
          class={`audience-btn py-3 px-4 rounded-lg text-sm font-bold border-2 border-black text-center transition-all cursor-pointer ${
            defaultAudience === 'child' 
              ? 'bg-black text-white' 
              : 'bg-white text-black hover:bg-slate-100'
          }`}
        >
          My Child
        </button>
      </div>
    </div>

    <!-- Submit Button (Bold Neo-Brutalist) -->
    <div class="pt-2">
      <button 
        type="submit" 
        class="btn-primary w-full h-14 text-lg sm:text-xl font-extrabold uppercase tracking-wider cursor-pointer"
      >
        Get Your Free Class
      </button>
    </div>

    <!-- Review Quote & 5-Star Social Proof -->
    <div class="pt-3 border-t border-slate-100 flex flex-col items-center justify-center text-center gap-1.5">
      <div class="flex items-center gap-1 text-amber-400">
        <svg class="w-4 h-4 fill-amber-400" viewBox="0 0 24 24">
          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
        </svg>
        <svg class="w-4 h-4 fill-amber-400" viewBox="0 0 24 24">
          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
        </svg>
        <svg class="w-4 h-4 fill-amber-400" viewBox="0 0 24 24">
          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
        </svg>
        <svg class="w-4 h-4 fill-amber-400" viewBox="0 0 24 24">
          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
        </svg>
        <svg class="w-4 h-4 fill-amber-400" viewBox="0 0 24 24">
          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
        </svg>
      </div>
      <p class="text-xs italic text-slate-600 font-medium max-w-xs leading-snug">
        "Hands down the best place to train! The culture, world-class instruction, and community are unmatched."
      </p>
      <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wide">— Zachary J., Google Review</span>
    </div>

  </form>

</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const audienceBtns = document.querySelectorAll('.audience-btn');
    const audienceInput = document.getElementById('targetAudienceInput');

    if (audienceBtns.length && audienceInput) {
      audienceBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-audience');
          if (audienceInput) audienceInput.value = val;
          
          audienceBtns.forEach(b => {
            b.className = 'audience-btn py-3 px-4 rounded-lg text-sm font-bold border-2 border-black text-black bg-white hover:bg-slate-100 text-center transition-all cursor-pointer';
          });
          
          btn.className = 'audience-btn py-3 px-4 rounded-lg text-sm font-bold border-2 border-black text-white bg-black text-center transition-all cursor-pointer';
        });
      });
    }
  });

  async function handleFormSubmit(form) {
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    const WEBHOOK_URL = 'https://services.leadconnectorhq.com/hooks/P7sCezLl1NDn8ujvBg1y/webhook-trigger/414b6507-d935-455f-9e4f-636b35813483';
    
    const isKidsPage = typeof window !== 'undefined' && window.location.pathname.includes('/kids');
    const isKidsForm = isKidsPage || data.formName === 'Kids Form' || data.formType === 'Kids Form' || data.targetAudience === 'child';
    const formLabel = isKidsForm ? 'Kids Form' : 'Adult Form';
    const sourcePage = isKidsPage ? 'Kids Class Landing Page' : 'Adult Class Landing Page';

    const firstName = data.fullName ? data.fullName.split(' ')[0] : '';
    const lastName = data.fullName ? data.fullName.split(' ').slice(1).join(' ') : '';

    // Push dataLayer event for GTM & Google Ads Enhanced Conversions
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      'event': 'generate_lead',
      'lead_type': formLabel,
      'source_page': sourcePage,
      'user_data': {
        'email': data.email || '',
        'phone_number': data.phone || '',
        'address': {
          'first_name': firstName,
          'last_name': lastName
        }
      }
    });

    const payload = JSON.stringify({
      full_name: data.fullName || '',
      first_name: data.fullName ? data.fullName.split(' ')[0] : '',
      last_name: data.fullName ? data.fullName.split(' ').slice(1).join(' ') : '',
      email: data.email || '',
      phone: data.phone || '',
      age: data.age || '',
      target_audience: data.targetAudience || (isKidsForm ? 'child' : 'myself'),
      form_name: formLabel,
      form_type: formLabel,
      source: sourcePage
    });

    try {
      await Promise.allSettled([
        fetch('/api/claim-pass', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        }),
        fetch(WEBHOOK_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: payload
        })
      ]);
    } catch (err) {
      console.log('Submission handled');
    }

    // Redirect to booking page
    window.location.href = '/booking';
  }
</script>
