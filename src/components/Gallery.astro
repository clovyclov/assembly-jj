---
---
<section id="gallery" class="py-20 bg-black text-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-rose-500 font-bold uppercase tracking-wider text-sm block mb-2">
        Academy Atmosphere
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold tracking-tight uppercase text-white">
        Inside the Academy
      </h2>
      <p class="mt-4 text-lg text-gray-400 leading-relaxed">
        Take a look at our training environment, our team, and the hard work that happens on the mats every day.
      </p>
    </div>

    <!-- Image Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Image 1 -->
      <div class="aspect-[4/3] overflow-hidden rounded-2xl border border-white/10 shadow-2xl relative group">
        <img 
          src="/gallery-1.png" 
          alt="Class in session at Assembly Jiu Jitsu" 
          class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
          <p class="font-heading text-lg uppercase font-bold text-white">Class in session</p>
        </div>
      </div>

      <!-- Image 2 -->
      <div class="aspect-[4/3] overflow-hidden rounded-2xl border border-white/10 shadow-2xl relative group">
        <img 
          src="/gallery-2.webp" 
          alt="Training on the mats at Assembly Jiu Jitsu" 
          class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
          <p class="font-heading text-lg uppercase font-bold text-white">Technique &amp; Sparring</p>
        </div>
      </div>

      <!-- Image 3 -->
      <div class="aspect-[4/3] overflow-hidden rounded-2xl border border-white/10 shadow-2xl relative group">
        <img 
          src="/gallery-3.webp" 
          alt="Black belt coaching at Assembly Jiu Jitsu" 
          class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
          <p class="font-heading text-lg uppercase font-bold text-white">World-Class Coaching</p>
        </div>
      </div>

    </div>

    <!-- CTA Button -->
    <div class="mt-14 text-center">
      <button 
        type="button" 
        class="open-modal-btn btn-primary h-14 px-10 text-lg font-extrabold uppercase tracking-wider rounded-none shadow-xl cursor-pointer"
      >
        Join Us On The Mats
      </button>
    </div>

  </div>
</section>
