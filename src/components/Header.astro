<header class="sticky top-0 z-50 w-full border-b border-slate-200/80 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/70 shadow-sm transition-all duration-300">
  <div class="container mx-auto flex h-20 items-center justify-between px-4 sm:px-6 lg:px-8">
    
    <!-- Logo -->
    <a href="#" class="flex items-center gap-2 group">
      <img 
        src="/logo.png" 
        alt="Assembly Jiu Jitsu Logo" 
        class="h-12 sm:h-14 w-auto object-contain transition-transform group-hover:scale-105 duration-300"
      />
    </a>

    <!-- Contact & CTA -->
    <div class="flex items-center gap-4 sm:gap-6">
      <a 
        href="tel:2484138386" 
        class="flex items-center gap-1.5 text-xs sm:text-sm font-extrabold sm:font-bold text-slate-900 border-2 border-black sm:border-transparent rounded-lg px-3 py-2 sm:px-3 sm:py-2 hover:bg-slate-100 transition-all"
        aria-label="Call Assembly Jiu Jitsu at (248) 413-8386"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-rose-600 h-3.5 w-3.5 sm:h-4 sm:w-4">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span class="sm:hidden uppercase tracking-wider">Call Us</span>
        <span class="hidden sm:inline font-bold tracking-tight">(248) 413-8386</span>
      </a>

      <button 
        type="button" 
        class="open-modal-btn btn-primary h-11 px-6 text-sm font-extrabold tracking-wider uppercase cursor-pointer"
      >
        Free Class
      </button>
    </div>

  </div>
</header>
