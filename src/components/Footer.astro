---
---
<footer class="bg-black text-white py-12 border-t border-white/10">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-center gap-8">
      
      <!-- Logo -->
      <div class="flex items-center gap-2">
        <img 
          src="/logo.png" 
          alt="Assembly Jiu Jitsu Logo" 
          class="h-12 w-auto object-contain brightness-0 invert"
        />
      </div>

      <!-- Address -->
      <div class="flex items-center text-gray-300 text-sm text-center md:text-left hover:text-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rose-500 mr-2 shrink-0">
          <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>281 Enterprise Ct Suite 400, Bloomfield Township, MI 48302</span>
      </div>

      <!-- Copyright -->
      <div class="text-gray-400 text-xs sm:text-sm">
        &copy; {new Date().getFullYear()} Assembly Jiu Jitsu. All rights reserved.
      </div>

    </div>
  </div>
</footer>
