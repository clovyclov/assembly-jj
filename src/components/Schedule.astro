---

<section id="schedule" class="py-16 sm:py-24 bg-slate-900 text-white relative overflow-hidden">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 max-w-5xl">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
      <span class="text-rose-500 font-extrabold uppercase text-xs sm:text-sm tracking-widest block mb-2">
        Weekly Class Times
      </span>
      <h2 class="text-3xl sm:text-5xl font-heading font-extrabold tracking-tight uppercase text-white mb-4">
        Class Schedule
      </h2>
      <p class="text-slate-300 text-sm sm:text-base">
        Flexible morning, afternoon, and evening sessions for adults, kids, and teens in Bloomfield Township.
      </p>
    </div>

    <!-- Interactive Schedule App Container -->
    <div class="bg-slate-800/90 rounded-2xl border border-slate-700/80 p-4 sm:p-8 shadow-2xl backdrop-blur-md">
      
      <!-- Day Selector Tabs -->
      <div class="flex items-center justify-between gap-1 sm:gap-2 border-b border-slate-700/80 pb-4 overflow-x-auto no-scrollbar mb-6">
        {scheduleData.map((d, index) => (
          <button
            type="button"
            data-day={d.day}
            class={`schedule-tab-btn flex-1 min-w-[70px] sm:min-w-[90px] py-2.5 px-3 rounded-xl text-xs sm:text-sm font-extrabold uppercase text-center transition-all cursor-pointer border ${
              index === 0 
                ? 'bg-rose-600 text-white border-rose-600 shadow-lg shadow-rose-600/25' 
                : 'bg-slate-900/60 text-slate-300 border-slate-700 hover:bg-slate-700 hover:text-white'
            }`}
          >
            <span class="block text-[11px] opacity-75 font-normal sm:hidden">{d.date}</span>
            <span class="hidden sm:block">{d.day}</span>
          </button>
        ))}
      </div>

      <!-- Schedule Content Panes -->
      <div>
        {scheduleData.map((d, index) => (
          <div 
            id={`schedule-pane-${d.day}`}
            class={`schedule-pane space-y-3 ${index === 0 ? 'block' : 'hidden'}`}
          >
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-heading font-bold text-white uppercase tracking-wider">
                {d.day} Schedule
              </h3>
              <span class="text-xs font-semibold text-slate-400 bg-slate-900/80 px-3 py-1 rounded-full border border-slate-700">
                {d.classes.length} {d.classes.length === 1 ? 'Class' : 'Classes'}
              </span>
            </div>

            {d.classes.map((c) => (
              <div class="bg-slate-900/80 border border-slate-700/70 hover:border-rose-500/50 rounded-xl p-4 sm:p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 transition-all hover:bg-slate-900">
                <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6 flex-1">
                  
                  <!-- Time Badge -->
                  <div class="flex items-center gap-2 bg-slate-800 text-rose-400 px-3 py-1.5 rounded-lg border border-slate-700 text-xs sm:text-sm font-mono font-bold shrink-0">
                    <svg class="w-4 h-4 text-rose-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <circle cx="12" cy="12" r="10" stroke-width="2" />
                      <polyline points="12 6 12 12 16 14" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    <span>{c.time} EDT</span>
                  </div>

                  <!-- Class Info -->
                  <div>
                    <h4 class="text-base sm:text-lg font-bold text-white tracking-tight">
                      {c.title}
                    </h4>
                    <span class={`inline-block mt-1 text-[11px] font-semibold px-2.5 py-0.5 rounded-full border ${c.tagColor}`}>
                      {c.audience}
                    </span>
                  </div>

                </div>

                <!-- CTA Button -->
                <button 
                  type="button" 
                  class="open-modal-btn w-full sm:w-auto btn-primary h-10 px-5 text-xs font-extrabold tracking-wider uppercase cursor-pointer shrink-0"
                >
                  Claim Free Pass
                </button>
              </div>
            ))}
          </div>
        ))}
      </div>

      <!-- Schedule Footer Note -->
      <div class="mt-8 pt-4 border-t border-slate-700/60 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-3 text-center sm:text-left">
        <p>📍 Location: 4086 W Maple Rd, Bloomfield Township, MI 48301</p>
        <button 
          type="button" 
          class="open-modal-btn text-rose-400 font-bold hover:underline cursor-pointer"
        >
          Have questions about the schedule? Contact Us →
        </button>
      </div>

    </div>

  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.schedule-tab-btn');
    const panes = document.querySelectorAll('.schedule-pane');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetDay = tab.getAttribute('data-day');

        // Reset tab styles
        tabs.forEach(t => {
          t.className = 'schedule-tab-btn flex-1 min-w-[70px] sm:min-w-[90px] py-2.5 px-3 rounded-xl text-xs sm:text-sm font-extrabold uppercase text-center transition-all cursor-pointer border bg-slate-900/60 text-slate-300 border-slate-700 hover:bg-slate-700 hover:text-white';
        });

        // Set active tab style
        tab.className = 'schedule-tab-btn flex-1 min-w-[70px] sm:min-w-[90px] py-2.5 px-3 rounded-xl text-xs sm:text-sm font-extrabold uppercase text-center transition-all cursor-pointer border bg-rose-600 text-white border-rose-600 shadow-lg shadow-rose-600/25';

        // Toggle visibility of schedule panes
        panes.forEach(pane => {
          if (pane.id === `schedule-pane-${targetDay}`) {
            pane.classList.remove('hidden');
            pane.classList.add('block');
          } else {
            pane.classList.add('hidden');
            pane.classList.remove('block');
          }
        });
      });
    });
  });
</script>
