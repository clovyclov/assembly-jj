---
---
<section id="coaches" class="py-20 bg-white text-slate-900 overflow-hidden">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      
      <!-- Text & Bullet Points -->
      <div>
        <span class="text-rose-600 font-bold uppercase tracking-wider text-sm block mb-2">
          World-Class Instruction
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold tracking-tight uppercase mb-6 text-slate-900">
          Trained by Champions
        </h2>
        <p class="text-lg text-slate-600 mb-8 leading-relaxed">
          At Assembly Jiu Jitsu, you're not just learning from instructors—you're learning from proven competitors. Our coaching staff consists of black belts who are actively competing on the world stage.
        </p>

        <ul class="space-y-4 mb-10">
          <li class="flex items-start">
            <div class="h-8 w-8 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center mr-4 flex-shrink-0 mt-1 border border-rose-100">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
                <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
                <path d="M4 22h16"></path>
                <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path>
                <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path>
                <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path>
              </svg>
            </div>
            <span class="text-lg font-medium text-slate-800">
              Active competitors who test their techniques at the highest levels.
            </span>
          </li>
          <li class="flex items-start">
            <div class="h-8 w-8 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center mr-4 flex-shrink-0 mt-1 border border-rose-100">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
                <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
                <path d="M4 22h16"></path>
                <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path>
                <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path>
                <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path>
              </svg>
            </div>
            <span class="text-lg font-medium text-slate-800">
              Proven track record of winning major championships.
            </span>
          </li>
          <li class="flex items-start">
            <div class="h-8 w-8 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center mr-4 flex-shrink-0 mt-1 border border-rose-100">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
                <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
                <path d="M4 22h16"></path>
                <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path>
                <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path>
                <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path>
              </svg>
            </div>
            <span class="text-lg font-medium text-slate-800">
              Experience in training and developing new champions.
            </span>
          </li>
        </ul>

        <button 
          type="button" 
          class="open-modal-btn btn-primary h-14 px-8 font-extrabold text-lg uppercase tracking-wider rounded-none shadow-xl cursor-pointer"
        >
          Start Training Today
        </button>
      </div>

      <!-- Image with floating badge -->
      <div class="relative">
        <div class="aspect-[4/3] overflow-hidden rounded-2xl shadow-2xl border border-slate-200">
          <img 
            src="/coaches.webp" 
            alt="Assembly Jiu Jitsu Coaches" 
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
          />
        </div>
        
        <!-- Floating badge -->
        <div class="absolute -bottom-6 -left-6 bg-white p-6 rounded-2xl shadow-2xl border border-slate-100 hidden md:block">
          <div class="flex items-center gap-4">
            <div class="bg-black text-white p-3.5 rounded-xl shadow-inner">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rose-500">
                <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
                <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
                <path d="M4 22h16"></path>
                <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path>
                <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path>
                <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path>
              </svg>
            </div>
            <div>
              <p class="font-heading font-bold text-xl text-slate-900 uppercase tracking-tight">Black Belt</p>
              <p class="text-slate-500 text-sm font-medium">Instructors &amp; Competitors</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
