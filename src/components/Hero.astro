---
import LeadForm from './LeadForm.astro';
---
<section id="hero" class="relative w-full overflow-hidden bg-black text-white py-12 md:py-20 lg:py-28">
  <!-- Video & Gradient Overlay -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <video 
      autoplay 
      loop 
      muted 
      playsinline 
      class="h-full w-full object-cover opacity-50 filter brightness-90"
      poster="/gallery-1.png"
    >
      <source src="/hero-video.mov" type="video/mp4" />
      <source src="https://assets.cdn.filesafe.space/P7sCezLl1NDn8ujvBg1y/media/69f6aaf2d868be0085327cc2.mov" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-gradient-to-r from-black via-black/45 to-black/30"></div>
  </div>

  <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Content -->
      <div class="lg:col-span-6 max-w-2xl">
        
        <!-- Social Proof Rating Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs sm:text-sm font-bold uppercase tracking-wider mb-4">
          <div class="flex gap-0.5 text-amber-400">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-4 h-4 fill-amber-400" viewBox="0 0 24 24">
                <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
              </svg>
            ))}
          </div>
          <span>5.0 Rating • 120+ Google Reviews</span>
        </div>
        
        <h1 class="mb-6 text-3xl sm:text-5xl lg:text-6xl font-heading font-extrabold tracking-tight uppercase leading-[1.1] text-white drop-shadow-md">
          LEARN SELF-DEFENSE FAST WITH JIU-JITSU
        </h1>

        <p class="text-base sm:text-xl text-gray-200 font-normal leading-relaxed mb-8">
          A fun, welcoming environment perfect for beginners and experienced grapplers alike. Train with champion black belts and transform your life.
        </p>

        <!-- Highlights -->
        <div class="grid grid-cols-2 gap-4 text-xs sm:text-sm font-semibold text-gray-300 border-t border-white/15 pt-6">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-rose-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>100% Beginner Friendly</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-rose-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Champion Black Belts</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-rose-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Adults &amp; Kids Programs</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-rose-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>No Experience Needed</span>
          </div>
        </div>
      </div>

      <!-- Right Lead Form (Matching User's Screenshot) -->
      <div class="lg:col-span-6 w-full">
        <LeadForm />
      </div>

    </div>
  </div>
</section>
